# Doxyfile for the gsk_family C++ public API.
#
# Generate with:   doxygen docs/Doxyfile     (run from the project root)
# Output:          build/doxygen/html/index.html   (gitignored, see .gitignore)
#
# This documents ONLY the C++ benchmark/tooling public API (the headers under
# benchmarks/cec_suite_cpp/cec_tools/include/gskcec). The GSK-family optimizers are MATLAB and
# are documented by their in-file help blocks plus docs/reference/matlab_interface.md;
# Doxygen does not read them here. See docs/reference/api.md.
#
# Notes on accuracy:
#  - Paths below are relative to the project root, so run Doxygen from there.
#  - HAVE_DOT is YES to draw Graphviz call/dependency graphs WHEN the `dot`
#    tool is installed. Doxygen degrades gracefully if `dot` is missing, but it
#    prints warnings; if you do not have Graphviz, set HAVE_DOT = NO (or install
#    Graphviz and ensure `dot` is on PATH). See docs/reference/api.md.

#---------------------------------------------------------------------------
# Project identity
#---------------------------------------------------------------------------
PROJECT_NAME           = "gsk_family C++ API"
PROJECT_BRIEF          = "Standalone C++ CEC benchmark ports and tooling (gskcec)"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES

#---------------------------------------------------------------------------
# What to document
#---------------------------------------------------------------------------
# Extract everything so undocumented members still appear (the headers are
# already richly commented, but EXTRACT_ALL guarantees full coverage).
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
# The public C++ headers. The suite headers (cec2011.hpp ... cec2020.hpp) live
# under the same include/ tree and are picked up by RECURSIVE.
INPUT                  = benchmarks/cec_suite_cpp/cec_tools/include
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h
INPUT_ENCODING         = UTF-8

# Use docs/reference/api.md as the landing page of the generated site.
USE_MDFILE_AS_MAINPAGE = docs/reference/api.md
INPUT                 += docs/reference/api.md

#---------------------------------------------------------------------------
# Build-related options
#---------------------------------------------------------------------------
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
ALWAYS_DETAILED_SEC    = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
GENERATE_TODOLIST      = YES
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

#---------------------------------------------------------------------------
# C++ language handling
#---------------------------------------------------------------------------
BUILTIN_STL_SUPPORT    = YES

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

#---------------------------------------------------------------------------
# Other output formats (off: HTML is the deliverable)
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

#---------------------------------------------------------------------------
# Diagrams (Graphviz). HAVE_DOT = YES draws richer graphs when `dot` exists.
# If Graphviz is not installed, set HAVE_DOT = NO to silence the warnings;
# class inheritance/collaboration diagrams still render without `dot`.
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 100
MAX_DOT_GRAPH_DEPTH    = 0
# Leave DOT_PATH empty to find `dot` on PATH; set it to the Graphviz bin folder
# if `dot` is installed somewhere off PATH, e.g. DOT_PATH = C:/Graphviz/bin
DOT_PATH               =
DOT_CLEANUP            = YES
