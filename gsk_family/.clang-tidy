# Static-analysis checks for the gsk_variants C++ sources.
# Focused on real bugs, performance, and portability; noisy or
# project-inappropriate checks are disabled with a reason.
---
Checks: >
  bugprone-*,
  performance-*,
  portability-*,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-using,
  modernize-loop-convert,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  readability-braces-around-statements,
  readability-redundant-*,
  readability-misleading-indentation,
  -bugprone-easily-swappable-parameters,
  -modernize-use-trailing-return-type,
  -performance-avoid-endl

# Treat nothing as an error by default so a normal/local build is never
# blocked. Run manually with, e.g.,
#   clang-tidy -p build --warnings-as-errors='*' <file>
# (the C++ compiler -Werror gate is what CI enforces; see .github/workflows/ci.yml).
WarningsAsErrors: ''

# Only diagnose this project's own headers (skip MATLAB extern/mex.h etc.).
HeaderFilterRegex: 'gskcec'
